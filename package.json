{
    "name": "mocha_api_soap_testing",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "tsc && mocha --spec 'dist/test/**/*.spec.js'",
        "test:rest": "tsc && mocha --spec 'dist/test/rest/**/*.spec.js'",
        "test:soap": "tsc && mocha --spec 'dist/test/soap/**/*.spec.js'",
        "test:regression": "tsc && mocha --spec 'dist/test/rest/regression/**/*.spec.js'",
        "test:soap:regression": "tsc && mocha --spec 'dist/test/soap/regression/**/*.spec.js'",
        "test:smoke": "tsc && mocha --spec 'dist/test/rest/smoke/**/*.spec.js'",
        "test:soap:smoke": "tsc && mocha --spec 'dist/test/soap/smoke/**/*.spec.js'",
        "test:report": "tsc && mocha --spec 'dist/test/**/*.spec.js' --reporter allure-mocha --reporter-option resultsDir=allure-results",
        "allure:generate": "allure generate allure-results --clean -o allure-report",
        "allure:open": "allure open allure-report",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jirivondra/mocha_api_soap_testing.git"
    },
    "keywords": [],
    "author": "",
