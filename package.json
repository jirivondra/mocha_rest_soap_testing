    "type": "commonjs",
    "bugs": {
        "url": "https://github.com/jirivondra/mocha_api_soap_testing/issues"
    },
    "homepage": "https://github.com/jirivondra/mocha_api_soap_testing#readme",
    "devDependencies": {
        "@faker-js/faker": "^10.5.0",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.9.3",
        "allure-commandline": "^2.42.1",
        "allure-mocha": "^3.10.0",
        "axios": "^1.18.0",
        "chai": "^6.2.2",
        "dotenv": "^17.4.2",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "mocha": "^11.7.6",
        "prettier": "^3.8.4",
        "soap": "^1.9.3",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1"
    },
